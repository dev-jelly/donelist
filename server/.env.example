# Donelist Server Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
SERVER_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=donelist
DB_USER=donelist
DB_PASSWORD=donelist_dev_password_change_in_production
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=1h

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password_change_in_production
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_EXPOSE_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Premium Features
PREMIUM_EDIT_HISTORY_ENABLED=true
PREMIUM_OLD_CHECKIN_EDIT_HOURS=2

# WebSocket Configuration
WS_MAX_MESSAGE_SIZE=512
WS_WRITE_TIMEOUT=10s
WS_READ_TIMEOUT=60s
WS_PING_PERIOD=54s

# Stripe Payment Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
# Test keys start with 'sk_test_', live keys start with 'sk_live_'
STRIPE_SECRET_KEY=sk_test_your_test_key_here
# Get this from the webhook endpoint settings in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Sync products with Stripe on startup (useful for development)
STRIPE_SYNC_PRODUCTS_ON_STARTUP=false

# Docker Compose specific (only used with docker-compose)
COMPOSE_PROJECT_NAME=donelist

# Backup and Recovery Configuration
BACKUP_DIR=/var/backups/donelist
BACKUP_SCHEDULE=0 2 * * *
BACKUP_ENABLED=true
RETENTION_DAYS=7
RETENTION_WEEKS=4
RETENTION_MONTHS=12
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=

# S3 Backup Storage
S3_ENDPOINT=
S3_BUCKET=donelist-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true

# WAL Archiving
WAL_ARCHIVING_ENABLED=false
WAL_ARCHIVE_DIR=/var/backups/donelist/wal

# Backup Monitoring
BACKUP_MONITORING_ENABLED=true
ALERT_WEBHOOK=
ALERT_ON_FAILURE=true
ALERT_ON_SUCCESS=false
MAX_BACKUP_AGE_HOURS=48
MIN_BACKUP_SIZE_MB=10
HEALTH_CHECK_INTERVAL=5m
